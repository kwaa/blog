---
// deep import: the package root re-exports the build hook which pulls in jsdom
import { getImagePath } from 'astro-takumi/dist/util.js'

import { footer, header, site } from '../config'
import '../styles/global.css'

interface Props {
  title?: string | undefined
  description?: string | undefined
  type?: 'website' | 'article'
}

const { title, description = site.description, type = 'website' } = Astro.props
const pageTitle = title ? `${title} | ${site.title}` : site.title
const canonical = new URL(Astro.url.pathname, site.url)
// pages build to directory format (dist/<slug>/index.html) but pathname has no
// trailing slash — append it so getImagePath points at <slug>/index.png
const ogImage = getImagePath({
  url: new URL(
    Astro.url.pathname.endsWith('/')
      ? Astro.url.pathname
      : `${Astro.url.pathname}/`,
    Astro.url,
  ),
  site: Astro.site,
})
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/any@180.webp" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title={site.title} href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title={site.title} href="/feed.json" />
    {site.head.me.map(me => <link rel="me" href={me} />)}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/"><strong>{site.title}</strong></a>
        <ul>
          {
            header.nav.map(item => (
              <li>
                {item.children
? (
                  <details>
                    <summary>{item.text}</summary>
                    <ul>
                      {item.children.map(child => (
                        <li>
                          <a href={child.link}>{child.text}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                )
: (
                  <a href={item.link}>{item.text}</a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav>
        <ul>
          {footer.nav.map(item => (
            <li>
              <a href={item.link}>{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>
      <Fragment set:html={footer.html} />
      <p>
        &copy; {new Date().getFullYear()} {site.author.name}
      </p>
    </footer>
  </body>
</html>
