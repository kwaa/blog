---
import type { Post } from '../utils/posts'
import { formatDate, postPath } from '../utils/posts'
import Tags from './Tags.astro'

interface Props {
  post: Post
}

const { post } = Astro.props
const { data } = post
---

<article>
  {data.image && (
    <a href={postPath(post)}>
      <img src={data.image} alt={data.title ?? post.id} loading="lazy" decoding="async" />
    </a>
  )}
  <header>
    <h2>
      <a href={postPath(post)}>{data.title ?? post.id}</a>
    </h2>
    {data.created && <time datetime={data.created.toISOString()}>{formatDate(data.created)}</time>}
  </header>
  {data.summary && <p>{data.summary}</p>}
  <Tags tags={data.tags} />
</article>
